{
  "name": "hackathon-template",
  "version": "0.1.0",
  "devDependencies": {
    "turbo": "^2.5.8"
  },
  "packageManager": "bun@1.3.12",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:frontend": "turbo run dev --filter=frontend",
    "dev:express": "turbo run dev --filter=express",
    "dev:fastapi": "turbo run dev --filter=fastapi",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "format": "turbo run format"
  },
  "workspaces": [
    "frontend",
    "express",
    "fastapi"
  ]
}
